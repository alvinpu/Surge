#!name=US Residential Checker
#!version=1.1.1
#!desc=每天 06:00 按美国名称筛选节点，每条线路仅查一次 IPPure，美国住宅即入组，自动更新 Static Residential。06:20 补位，面板刷新可手动重测。
#!requirement=SYSTEM = 'macOS'
[Script]
US Residential Scan = type=cron,cronexp="0 6 * * *",timeout=720,script-path=https://raw.githubusercontent.com/alvinpu/Surge/c5e8984cb8a55de831903657ed8c2ace9a9070e2/Modules/US-Residential-Checker/residential.js,argument=primary
US Residential Backup = type=cron,cronexp="20 6 * * *",timeout=720,script-path=https://raw.githubusercontent.com/alvinpu/Surge/c5e8984cb8a55de831903657ed8c2ace9a9070e2/Modules/US-Residential-Checker/residential.js,argument=backup
US Residential Results = type=generic,timeout=720,script-path=https://raw.githubusercontent.com/alvinpu/Surge/c5e8984cb8a55de831903657ed8c2ace9a9070e2/Modules/US-Residential-Checker/residential.js,argument=panel
[Panel]
US Residential Results = script-name=US Residential Results,title=Static Residential,content="点刷新按钮开始检测",update-interval=300
